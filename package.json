{
  "name": "neurolook",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Local-first browser for NeuroMorpho.Org's neuron morphology library.",
  "scripts": {
    "start": "node server/server.js",
    "lint": "eslint public/js server test",
    "format": "prettier --write public/js server test *.js *.json",
    "format:check": "prettier --check public/js server test *.js *.json",
    "test": "node --test test/",
    "typecheck": "tsc --project public/js/jsconfig.json && tsc --project server/jsconfig.json"
  },
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^20.19.43",
    "@types/three": "^0.160.0",
    "eslint": "^10.9.1",
    "prettier": "^3.9.6",
    "three": "^0.160.0",
    "typescript": "^7.0.2"
  }
}
